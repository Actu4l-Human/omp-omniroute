{
  "name": "@actu4l-human/omp-omniroute",
  "version": "1.4.2",
  "type": "module",
  "description": "A focused dynamic OmniRoute provider extension for Oh My Pi",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Actu4l-Human/omp-omniroute.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "index.ts",
    "src/*.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/*.md",
    ".env.example",
    "overrides.example.json"
  ],
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test:integration": "node test/run-bun.ts test ./test/reported-cost.integration.ts ./test/specialty.integration.ts",
    "test:cli": "node test/run-bun.ts test/cli-smoke.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@oh-my-pi/pi-ai": "^18.18.6",
    "@oh-my-pi/pi-coding-agent": "^18.18.6",
    "@types/node": "26.6.6",
    "bun": "1.4.4",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@oh-my-pi/pi-coding-agent@^18.18.6": {
      "puppeteer-core": "25.16.0"
    }
  },
  "omp": {
    "extensions": [
      "./index.ts"
    ]
  },
  "allowScripts": {
    "bun@1.4.4": true
  }
}
