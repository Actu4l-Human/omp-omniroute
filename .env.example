# Example values only. The extension does not automatically read this file.
# Supply the real key through your shell or secret manager; do not commit it.
OMNIROUTE_BASE_URL=https://your-router.example.com/v1
OMNIROUTE_API_KEY=
OMNIROUTE_REFRESH_MS=300000
OMNIROUTE_TIMEOUT_MS=12000
OMNIROUTE_INCLUDE=
OMNIROUTE_EXCLUDE=
OMNIROUTE_REQUIRE_TOOLS=true
OMNIROUTE_VARIABLE_PRICE=
OMNIROUTE_REPORTED_COST=false
OMNIROUTE_ALLOW_INSECURE_HTTP=false

# v1.1 features
OMNIROUTE_INSPECT_REQUESTS=true
OMNIROUTE_CATALOG_ALERTS=true
OMNIROUTE_OVERRIDES_FILE=
OMNIROUTE_STICKY_SESSIONS=false
OMNIROUTE_BYPASS_CACHE=false
OMNIROUTE_BYPASS_MEMORY=false
